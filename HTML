<label>Username</label>

<input
    type="text"
    name="username"
    placeholder="Enter Username (e.g. pooja123)"
    value="{{ username }}"
    required
>

<label>Enter Message</label>

<textarea
    name="message"
    placeholder="Enter your online message/comment here..."
    required
>{{ message }}</textarea>

<button type="submit">
    Detect Message
</button>
<br><br>

<a href="/history">
    <button type="button">
        View Detection History
    </button>
</a>
<a href="/history"
class="history-btn">View Detection
History</a>
